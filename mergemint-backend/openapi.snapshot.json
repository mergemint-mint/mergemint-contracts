        "operationId": "bounty_stream",
        "responses": {
          "200": {
            "description": "SSE stream of bounty state changes"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppError"
                }
              }
            },
            "description": "Too many concurrent stream connections"
          }
        },
        "summary": "`GET /bounties/stream`",
        "tags": [
          "bounties"
        ]
      }
    },
