# =============================================================================
# Ethereum bounty-refresh scripts (scripts/batchRefresh.js)
# =============================================================================
BOUNTY_REFRESH_ADDRESS=0x...
NETWORK_RPC_URL=http://localhost:8545
PRIVATE_KEY=0x...

# Soroban / Stellar configuration (see docs/integrations.md)

# RPC endpoint for the Soroban network
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban-mainnet.stellar.org (or your own horizon/RPC node)
RPC_URL=https://soroban-testnet.stellar.org

# The deployed MergeMint contract address (C... address returned by stellar contract deploy)
CONTRACT_ID=C...

# Network passphrase used to hash and sign transactions.
# Testnet:  Networks.TESTNET  → "Test SDF Network ; September 2015"
# Mainnet:  Networks.PUBLIC   → "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Short network label consumed by the Stellar CLI and helper scripts
# Values: testnet | mainnet | futurenet | localnet
SOROBAN_NETWORK=testnet

# SSE keep-alive interval in seconds. Prevents idle SSE connections from being
# closed by proxies and load balancers. Defaults to 15 seconds.
SSE_KEEP_ALIVE_SECS=15

# =============================================================================
# Frontend Content-Security-Policy (frontend/, issue #1114)
# =============================================================================

# Origin of the Stellar RPC endpoint (used in connect-src).
# Example:  https://soroban-testnet.stellar.org
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Origin of the mergemint-backend API (used in connect-src).
# Example:  https://api.mergemint.xyz
VITE_API_URL=http://localhost:8080

# CSP violation reporting endpoint.  Leave empty to omit report-uri.
VITE_CSP_REPORT_URI=

# Set to "false" to switch from report-only to enforcing mode.
# Default is "true" (report-only) so the first deployment never silently
# breaks pages before violations have been monitored.
VITE_CSP_REPORT_ONLY=true

# =============================================================================
# Backend security headers (mergemint-backend/, issue #1115)
# =============================================================================

# Set to "true" to include Strict-Transport-Security header.
# Should only be enabled when the service is behind HTTPS.
HSTS_ENABLED=false
