# =============================================================================
# Ethereum bounty-refresh scripts (scripts/batchRefresh.js)
# =============================================================================
BOUNTY_REFRESH_ADDRESS=0x...
NETWORK_RPC_URL=http://localhost:8545
PRIVATE_KEY=0x...

# Soroban / Stellar configuration (see docs/integrations.md)

# RPC endpoint for the Soroban network
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://soroban-mainnet.stellar.org (or your own horizon/RPC node)
RPC_URL=https://soroban-testnet.stellar.org

# The deployed MergeMint contract address (C... address returned by stellar contract deploy)
CONTRACT_ID=C...

# Network passphrase used to hash and sign transactions.
# Testnet:  Networks.TESTNET  → "Test SDF Network ; September 2015"
# Mainnet:  Networks.PUBLIC   → "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Short network label consumed by the Stellar CLI and helper scripts
# Values: testnet | mainnet | futurenet | localnet
SOROBAN_NETWORK=testnet

# SSE keep-alive interval in seconds. Prevents idle SSE connections from being
# closed by proxies and load balancers. Defaults to 15 seconds.
SSE_KEEP_ALIVE_SECS=15

# Email notifications use SMTP over implicit TLS (default port 465).
# Set both SMTP_USERNAME and SMTP_PASSWORD when the provider requires auth.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.com
PUBLIC_BASE_URL=https://api.example.com

# Deadline reminders run once per minute and notify 24 hours before deadline.
DEADLINE_REMINDER_LEAD_HOURS=24
DEADLINE_REMINDER_INTERVAL_SECS=60

# Backend security headers (see docs/security.md). Only enable HSTS when the
# backend is reached over HTTPS, e.g. behind a TLS-terminating proxy.
HSTS_ENABLED=false
HSTS_MAX_AGE_SECS=31536000
HSTS_INCLUDE_SUBDOMAINS=false

# Frontend Content Security Policy (see docs/security.md).
# report-only (default) | enforce | off
VITE_CSP_MODE=report-only
# Optional endpoint for CSP violation reports.
VITE_CSP_REPORT_URI=
# Extra comma-separated RPC/Horizon URLs the frontend may connect to.
VITE_RPC_URLS=
